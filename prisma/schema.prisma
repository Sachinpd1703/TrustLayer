datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// --------------------------------------------------------
// 0. Multi-Tenant Enterprise Organization & User Hierarchy
// --------------------------------------------------------
model Organization {
  id           String        @id @default(uuid())
  name         String
  slug         String        @unique
  logoUrl      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  agents       Agent[]
  policies     PolicyRule[]
  users        User[]
  transactions Transaction[]
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  name           String?
  role           String        @default("ADMIN")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}

// --------------------------------------------------------
// 1. Department & Organization Hierarchy
// --------------------------------------------------------
enum DepartmentRole {
  ENGINEERING
  MARKETING
  SALES
  OPERATIONS
  EXECUTIVE
  GENERAL
}

model Department {
  id          String         @id @default(cuid())
  code        DepartmentRole @unique
  name        String         // e.g. "Engineering & Infrastructure"
  description String?
  agents      Agent[]
  policies    PolicyRule[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt
}

// --------------------------------------------------------
// 2. Agent IAM & Identity Registry
// --------------------------------------------------------
enum AgentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model Agent {
  id               String            @id @default(cuid())
  agentId          String            @unique // e.g. "agent_procure_v2"
  name             String
  description      String?
  publicKey        String            // Ed25519 public key in hex
  status           AgentStatus       @default(ACTIVE)
  role             String            @default("BUYER_AGENT")
  ownerEmail       String
  departmentId     String?
  department       Department?       @relation(fields: [departmentId], references: [id])
  organizationId   String?
  organization     Organization?     @relation(fields: [organizationId], references: [id])
  
  // Financial Caps (in Paise)
  maxPerOrderCap   Int               @default(500000)   // ₹5,000 auto-allow threshold
  dailySpendCap    Int               @default(2000000)  // ₹20,000 daily velocity limit
  monthlyBudgetCap Int               @default(10000000) // ₹1,00,000 monthly limit
  totalSpentPaise  BigInt            @default(0)
  
  tokens           AgentToken[]
  transactions     Transaction[]
  virtualCards     VirtualCard[]
  approvals        PendingApproval[]
  auditLogs        AuditLog[]
  
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([departmentId])
  @@index([organizationId])
}

model AgentToken {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tokenPrefix String    // e.g. "tl_live_sec_..."
  tokenHash   String    // SHA-256 hash of full secret token
  name        String    // e.g. "Production Claude Desktop Token"
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tokenPrefix])
  @@index([tokenHash])
}

// --------------------------------------------------------
// 3. Multi-Tier Hierarchical Spend Policies
// --------------------------------------------------------
model PolicyRule {
  id                   String        @id @default(cuid())
  name                 String        @unique // e.g. "GlobalEnterpriseSaaSPolicy"
  description          String?
  isActive             Boolean       @default(true)
  departmentId         String?
  department           Department?   @relation(fields: [departmentId], references: [id])
  organizationId       String?
  organization         Organization? @relation(fields: [organizationId], references: [id])
  
  // Multi-Tier Spend Thresholds (in Paise)
  tier1MaxOrderPaise   Int           @default(500000)   // Tier 1: Auto-Allow (<= ₹5,000)
  tier2ThresholdPaise  Int           @default(2500000)  // Tier 2: Single Manager (<= ₹25,000)
  tier3ThresholdPaise  Int           @default(10000000) // Tier 3: Dual-Custody (<= ₹1,00,000)
  hardCeilingPaise     Int           @default(10000000) // Tier 4: Absolute Block (> ₹1,00,000)
  dailySpendLimitPaise Int           @default(2000000)  // Rolling 24h limit (₹20,000)
  
  // Whitelists & Blocklists
  allowedCurrencies    String[]      @default(["INR"])
  allowedMccs          String[]      @default(["5734", "7372", "4816", "7011", "4511"])
  blockedMccs          String[]      @default(["6051", "7995", "4829"])
  allowedMerchants     String[]      @default(["mid_slack_01", "mid_figma_01", "mid_aws_01", "mid_github_01", "mid_cloudflare_01", "mid_taj_hotels", "mid_indigo_air"])
  
  // Temporal Guardrails (Working Hours)
  enforceWorkingHours  Boolean       @default(false)
  workingDays          String[]      @default(["MON", "TUE", "WED", "THU", "FRI"])
  startHourUtc         Int           @default(3)        // 08:30 AM IST (03:00 UTC)
  endHourUtc           Int           @default(14)       // 07:30 PM IST (14:00 UTC)
  
  // Risk Scoring Sensitivity
  riskScoreThreshold   Float         @default(0.35)
  
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now()) @updatedAt

  @@index([isActive])
  @@index([departmentId])
  @@index([organizationId])
}

// --------------------------------------------------------
// 4. Transactions & Gating Records
// --------------------------------------------------------
enum DecisionType {
  ALLOW
  REQUIRE_APPROVAL
  DENY
}

enum TransactionStatus {
  PENDING
  EXECUTED
  BLOCKED
  REJECTED
  FAILED
}

model Transaction {
  id                  String               @id @default(cuid())
  agentId             String
  agent               Agent                @relation(fields: [agentId], references: [agentId])
  amountPaise         Int                  // e.g. 160000 (₹1,600)
  currency            String               @default("INR")
  merchantId          String               // Target Razorpay Merchant ID
  merchantCategory    String?              // e.g. "SaaS_Subscription"
  mccCode             String?              // e.g. "5734"
  intent              String               // Human-readable declared intent
  reasoningHash       String               // SHA256 of LLM reasoning payload
  reasoningText       String?              // Detailed reasoning string
  decision            DecisionType         @default(ALLOW)
  decisionReason      String               // e.g. "Auto-approved within spend cap"
  razorpayOrderId     String?              // e.g. "order_RZP10293847"
  razorpayPaymentId   String?
  status              TransactionStatus    @default(PENDING)
  riskScore           Float                @default(0.1)
  rawRequestPayload   Json                 // Postgres native JSONB
  rawResponsePayload  Json?                // Postgres native JSONB
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @default(now()) @updatedAt

  beneficiary         BeneficiaryMetadata?
  virtualCard         VirtualCard?
  pendingApproval     PendingApproval?
  auditLogs           AuditLog[]

  @@index([agentId])
  @@index([decision])
  @@index([status])
  @@index([razorpayOrderId])
  @@index([createdAt])
  @@index([organizationId])
}


// --------------------------------------------------------
// 5. Employee Beneficiary & License Metadata
// --------------------------------------------------------
enum ProvisioningStatus {
  PENDING
  ACTIVE
  REVOKED
  CANCELLED
}

model BeneficiaryMetadata {
  id                 String             @id @default(cuid())
  transactionId      String             @unique
  transaction        Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  employeeEmail      String             // e.g. "rohit.sharma@enterprise.internal"
  employeeName       String?            // e.g. "Rohit Sharma"
  employeeId         String?            // e.g. "EMP_1042"
  departmentCode     String?            // e.g. "ENGINEERING"
  workspaceId        String?            // e.g. "figma_org_techventure"
  licenseType        String?            // e.g. "FIGMA_DESIGN_EDITOR", "SLACK_PRO_SEAT"
  provisioningStatus ProvisioningStatus @default(PENDING)
  provisionedAt      DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  @@index([employeeEmail])
  @@index([provisioningStatus])
}

// --------------------------------------------------------
// 6. Ephemeral Single-Use Virtual Cards (10-Minute TTL)
// --------------------------------------------------------
enum VirtualCardStatus {
  ACTIVE
  CHARGED
  EXPIRED
  TERMINATED
}

model VirtualCard {
  id                String            @id @default(cuid())
  agentId           String
  agent             Agent             @relation(fields: [agentId], references: [agentId])
  transactionId     String?           @unique
  transaction       Transaction?      @relation(fields: [transactionId], references: [id])
  cardToken         String            @unique // Tokenized reference
  maskedPan         String            // e.g. "4111-XXXX-XXXX-8921"
  cardholderName    String            @default("TrustLayer AI Autonomous Buyer")
  currency          String            @default("INR")
  spendLimitPaise   Int               // Exact single-use authorization cap
  currentSpentPaise Int               @default(0)
  status            VirtualCardStatus @default(ACTIVE)
  expiresAt         DateTime          // 10-minute TTL
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([expiresAt])
}

// --------------------------------------------------------
// 7. SaaS Subscriptions & Active Seat Directory
// --------------------------------------------------------
enum SeatStatus {
  ACTIVE
  INACTIVE
  PENDING_PRUNING
  CANCELLED
}

model SubscriptionSeat {
  id                String     @id @default(cuid())
  merchantId        String     // e.g. "mid_figma_01"
  merchantName      String     // e.g. "Figma Design Platform"
  sku               String     // e.g. "figma_dev_seat_monthly"
  allocatedEmail    String     // e.g. "rohit.sharma@enterprise.internal"
  allocatedName     String?    // e.g. "Rohit Sharma"
  employeeId        String?    // e.g. "EMP_1042"
  departmentCode    String?    // e.g. "ENGINEERING"
  monthlyCostPaise  Int        // in paise (e.g. 80000 for ₹800)
  status            SeatStatus @default(ACTIVE)
  lastActivityDate  DateTime?  @default(now())
  nextRenewalDate   DateTime
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt

  @@unique([merchantId, allocatedEmail])
  @@index([merchantId])
  @@index([allocatedEmail])
  @@index([status])
  @@index([nextRenewalDate])
}

// --------------------------------------------------------
// 8. Human Step-Up Approvals Queue (Dual-Custody)
// --------------------------------------------------------
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ApprovalTier {
  TIER_SINGLE_MANAGER
  TIER_DUAL_CUSTODY
}

model PendingApproval {
  id                  String         @id @default(cuid())
  transactionId       String         @unique
  transaction         Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  agentId             String
  agent               Agent          @relation(fields: [agentId], references: [agentId])
  amountPaise         Int
  currency            String
  merchantId          String
  tier                ApprovalTier   @default(TIER_SINGLE_MANAGER)
  triggerReason       String         // e.g. "Amount ₹35,000 exceeds ₹5,000 autonomous limit"
  status              ApprovalStatus @default(PENDING)
  
  // Primary Approver (Department Manager)
  approverEmail       String?
  approverSignature   String?        // Digital signature / session hash
  
  // Secondary Approver (for Dual-Custody Tier 3)
  secondApproverEmail String?
  secondApproverSig   String?
  
  decisionNotes       String?
  expiresAt           DateTime       @default(now())
  createdAt           DateTime       @default(now())
  resolvedAt          DateTime?
  updatedAt           DateTime       @default(now()) @updatedAt

  @@index([agentId])
  @@index([status])
  @@index([tier])
}

// --------------------------------------------------------
// 9. Tamper-Evident Hash-Chained Audit Ledger
// --------------------------------------------------------
model AuditLog {
  id                  String       @id @default(cuid())
  logIndex            Int          @unique @default(autoincrement())
  transactionId       String
  transaction         Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  agentId             String
  agent               Agent        @relation(fields: [agentId], references: [agentId])
  timestamp           DateTime     @default(now())
  amountPaise         Int
  decision            DecisionType @default(ALLOW)
  intent              String
  reasoningHash       String
  policyEvaluationJson Json        // Postgres native JSONB breakdown
  previousLogHash     String       // SHA256 hash of logIndex - 1
  currentLogHash      String       // SHA256(previousLogHash + payload)

  @@index([logIndex])
  @@index([agentId])
  @@index([timestamp])
}

// --------------------------------------------------------
// 10. Omnichannel Webhook Integrations
// --------------------------------------------------------
enum WebhookChannel {
  TELEGRAM
  WHATSAPP
  SLACK
  CUSTOM_HTTP
}

model WebhookIntegration {
  id          String         @id @default(cuid())
  channel     WebhookChannel
  name        String         // e.g. "Finance Telegram Approval Bot"
  webhookUrl  String
  channelId   String?        // Telegram Chat ID / Slack Channel ID
  secretToken String?        // For HMAC callback verification
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@index([channel])
  @@index([isActive])
}

// --------------------------------------------------------
// 11. Agent Anti-Replay Nonce Store
// --------------------------------------------------------
model AgentNonce {
  id        String   @id @default(uuid())
  agentId   String
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([agentId, nonce])
  @@index([expiresAt])
}
